# RDR2 Living NPC Agent - local configuration
#
# Copy this file to `.env` (or run `python3 install.py --api-key <KEY>`) and the
# runtime picks these up automatically.  Real shell environment variables always
# win over this file, so CI or a one-off `export` still overrides it.
#
#   cp .env.example .env
#
# `.env` is git-ignored - never commit a real key.

# ---------------------------------------------------------------------------
# Model access (only needed for --backend llm / adk)
# ---------------------------------------------------------------------------
# The key that matches `api_key_env` below.  Either name works; OPENCODE_API_KEY
# is checked first.
OPENCODE_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime defaults (equivalent to the CLI flags)
# ---------------------------------------------------------------------------
# rule = offline deterministic | llm = built-in OpenAI-compatible (no packages)
# adk  = Google ADK + LiteLLM
RDR2AI_BACKEND=llm

# Any OpenAI-compatible endpoint:
#   OpenCode Go   https://opencode.ai/zen/go/v1
#   OpenAI        https://api.openai.com/v1
#   Ollama        http://127.0.0.1:11434/v1
#   LM Studio     http://127.0.0.1:1234/v1
RDR2AI_API_BASE=https://opencode.ai/zen/go/v1
RDR2AI_MODEL=deepseek-v4.1-flash
RDR2AI_PROVIDER=openai
# RDR2AI_API_KEY_ENV=OPENCODE_API_KEY
