# RDR2 Living NPC Agent - local configuration
#
# Both runtimes read this file automatically from the folder that holds
# `config/` and `data/`:
#
#   standalone bundle   edit this .env next to rdr2-npc.exe and paste your key
#   from a git checkout  cp .env.example .env   (or: python3 install.py --api-key "sk-your-key")
#
# Real shell environment variables always win over this file, so CI or a
# one-off `export` still overrides it.  It is git-ignored: never commit a real
# key, and never paste one into config/settings.json, which is tracked.

# ---------------------------------------------------------------------------
# Model access (only needed for the adk/llm backends; `rule` runs offline)
# ---------------------------------------------------------------------------
# Paste your key after the `=`.  Either name works; OPENCODE_API_KEY is checked
# first.  RDR2AI_API_KEY_ENV at the bottom can point at a different variable.
OPENCODE_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime defaults (equivalent to the CLI flags)
# ---------------------------------------------------------------------------
# rule = offline deterministic, needs no key
# llm  = model backend. The name works in BOTH runtimes: the standalone
#        executable treats it as its ADK backend, and the Python runtime uses
#        its built-in client (no extra packages).
RDR2AI_BACKEND=llm

# Any OpenAI-compatible endpoint:
#   OpenCode Go   https://opencode.ai/zen/go/v1
#   OpenAI        https://api.openai.com/v1
#   Ollama        http://127.0.0.1:11434/v1
#   LM Studio     http://127.0.0.1:1234/v1
RDR2AI_API_BASE=https://opencode.ai/zen/go/v1
RDR2AI_MODEL=deepseek-v4.1-flash
RDR2AI_PROVIDER=openai
# RDR2AI_API_KEY_ENV=OPENCODE_API_KEY
